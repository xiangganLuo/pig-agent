<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.pigagent</groupId>
        <artifactId>pig-agent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pig-agent-web</artifactId>
    <name>Pig Agent Web Console</name>
    <description>Embedded local web console: an AgentKernel adapter (REST + SSE) over the JDK
        HttpServer. Loopback-only, single-user, no DB — a personal-computer visual front-end.</description>

    <dependencies>
        <!-- The kernel façade + events this console adapts. No internal-kernel deps. -->
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-config</artifactId>
        </dependency>

        <!-- JSON for REST/SSE payloads. The HTTP server itself is the JDK built-in
             com.sun.net.httpserver — no external web framework (keeps deps light, offline-safe). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Reactor comes transitively via agentscope (KernelEvent Flux). -->
    </dependencies>
</project>
