<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.pigagent</groupId>
        <artifactId>pig-agent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pig-agent-plugin-builtin</artifactId>
    <name>Pig Agent - Built-in Plugins</name>
    <description>Built-in plugins contributed through the Plugin SPI: common offline compute tools plus the extracted web search / web fetch / checklist tools</description>

    <dependencies>
        <!-- Plugin SPI (transitively brings pig-agent-tools + core + agentscope) -->
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-plugin</artifactId>
        </dependency>
        <!-- Tool annotations (@Tool/@ToolParam) + the {"error"} return contract (ToolErrors) -->
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-tools</artifactId>
        </dependency>
        <!-- Explicit for @Tool / Toolkit (also transitive via the SPI) -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
        </dependency>
        <!-- JSON pretty-print / validate (battle-tested; version managed by the parent POM) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
