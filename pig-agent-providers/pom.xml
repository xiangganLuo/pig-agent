<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.pigagent</groupId>
        <artifactId>pig-agent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pig-agent-providers</artifactId>
    <name>Pig Agent - LLM Providers</name>
    <description>LLM provider registry and discovery</description>

    <dependencies>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope</artifactId>
        </dependency>

        <!-- Provider client SDKs (optional in agentscope; required at compile + runtime
             for the AnthropicChatModel / OpenAIChatModel / GeminiChatModel / DashScopeChatModel
             builders used by the providers here). Ollama needs no SDK. -->
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.genai</groupId>
            <artifactId>google-genai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>dashscope-sdk-java</artifactId>
            <!-- The DashScope SDK bundles slf4j-simple, which collides with our Logback backend
                 ("multiple SLF4J providers"). Exclude it so Logback is the sole binding. -->
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
