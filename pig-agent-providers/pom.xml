<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.pigagent</groupId>
        <artifactId>pig-agent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pig-agent-providers</artifactId>
    <name>Pig Agent - LLM Providers</name>
    <description>LLM provider registry and discovery</description>

    <dependencies>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-core</artifactId>
        </dependency>

        <!-- AgentScope 2.0 per-provider model extensions. Each supplies its
             {OpenAI,Anthropic,Gemini,Ollama,DashScope}ChatModel builder and bundles the vendor SDK
             transitively, so the explicit com.anthropic / com.openai / com.google.genai /
             com.alibaba declarations from the 1.x setup are no longer needed here. -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-gemini</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
            <!-- The DashScope SDK bundles slf4j-simple, which collides with our Logback backend
                 ("multiple SLF4J providers"). Exclude it so Logback is the sole binding. -->
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>
</project>
