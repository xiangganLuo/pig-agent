<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback config for the Pig Agent entry module (PigAgentCli).
  Console + rolling file. Logs land under the workspace: ~/.pig-agent/workspace/logs/.
  Adjust io.pigagent level for more/less detail; noisy third parties are pinned to WARN.
-->
<configuration>

    <property name="LOG_DIR" value="${user.home}/.pig-agent/workspace/logs"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <!--
          Keep the interactive TUI clean: only ERROR (and above) ever reach the console; all
          INFO/WARN startup + rebuild noise (model switches, /mcp + /memory rebuilds, the native
          AGENTS.md scan, the "忽略未知配置字段" config-drift WARN, …) goes to the FILE appender
          only. Genuinely user-facing startup facts are printed via Ansi/banner, not the logger,
          and REPL errors surface via Ansi.error — so nothing user-relevant is lost. %nopex keeps
          even an ERROR line to one line on the console (the FILE keeps the full stack trace).
        -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%nopex%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/pig-agent.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/pig-agent.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Our own code at INFO; tame noisy libraries. -->
    <logger name="io.pigagent" level="INFO"/>
    <logger name="org.jline" level="WARN"/>
    <logger name="io.agentscope" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
