<?xml version="1.0" encoding="UTF-8"?>
<!-- Quiet, console-only logging for tests (no rolling file). Keeps test output readable and
     provides an SLF4J backend so there is no "No providers found → NOP" warning. -->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
