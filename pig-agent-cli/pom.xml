<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.pigagent</groupId>
        <artifactId>pig-agent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pig-agent-cli</artifactId>
    <name>Pig Agent - CLI</name>
    <description>Terminal REPL entry point</description>

    <properties>
        <!-- Coverage ratchet floor (ci-quality-gate): floor(current) - 0.02. -->
        <jacoco.line.min>0.27</jacoco.line.min>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-providers</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-workspace</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-task</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-session</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-model</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-channel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-config</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-onboarding</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.pigagent</groupId>
            <artifactId>pig-agent-plugin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal-jna</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli-shell-jline3</artifactId>
        </dependency>
        <dependency>
            <groupId>org.fusesource.jansi</groupId>
            <artifactId>jansi</artifactId>
        </dependency>
        <!-- Logging backend: the CLI is the entry module, so it provides Logback.
             Library modules depend only on the SLF4J API (transitively available). -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.pigagent.cli.PigAgentCli</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>
                <configuration>
                    <mainClass>io.pigagent.cli.PigAgentCli</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
