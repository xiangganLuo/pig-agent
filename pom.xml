<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.pigagent</groupId>
    <artifactId>pig-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Pig Agent</name>
    <description>A terminal-based AI agent framework built on AgentScope Java</description>
    <url>https://github.com/xiangganLuo/pig-agent</url>

    <licenses>
        <license>
            <name>Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>ls</name>
            <email>xiangganluo@gmail.com</email>
            <organization>ls</organization>
            <roles>
                <role>author</role>
            </roles>
        </developer>
    </developers>

    <issueManagement>
        <system>Github Issue</system>
        <url>https://github.com/xiangganLuo/pig-agent/issues</url>
    </issueManagement>

    <scm>
        <connection>scm:https://github.com/xiangganLuo/pig-agent</connection>
        <developerConnection>scm:git@github.com:xiangganLuo/pig-agent.git</developerConnection>
        <url>https://github.com/xiangganLuo/pig-agent</url>
    </scm>

    <modules>
        <module>pig-agent-core</module>
        <module>pig-agent-providers</module>
        <module>pig-agent-tools</module>
        <module>pig-agent-workspace</module>
        <module>pig-agent-task</module>
        <module>pig-agent-session</module>
        <module>pig-agent-model</module>
        <module>pig-agent-channel</module>
        <module>pig-agent-config</module>
        <module>pig-agent-onboarding</module>
        <module>pig-agent-mcp</module>
        <module>pig-agent-plugin</module>
        <module>pig-agent-plugin-builtin</module>
        <module>pig-agent-skills-builtin</module>
        <module>pig-agent-web</module>
        <module>pig-agent-cli</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Core dependencies -->
        <!-- agentscope2.version: AgentScope 2.0 split artifacts (core + harness + model extensions).
             The whole reactor is on pure 2.0 artifacts (av2 Phase 5a); the legacy 1.x all-in-one
             `io.agentscope:agentscope` dependency + its `agentscope.version` property were removed. -->
        <agentscope2.version>2.0.0</agentscope2.version>
        <jline.version>3.28.0</jline.version>
        <picocli.version>4.7.6</picocli.version>
        <snakeyaml.version>2.3</snakeyaml.version>
        <jackson.version>2.18.3</jackson.version>
        <jansi.version>2.4.1</jansi.version>
        <!-- Logging: SLF4J facade (aligned with the version AgentScope brings) + Logback backend.
             The backend is declared only by the entry module (pig-agent-cli); libraries use the API. -->
        <slf4j.version>2.0.16</slf4j.version>
        <logback.version>1.5.34</logback.version>

        <!-- LLM provider client SDKs (optional in agentscope; versions matched to 1.0.12) -->
        <anthropic.version>2.14.0</anthropic.version>
        <openai-java.version>4.28.0</openai-java.version>
        <google-genai.version>1.45.0</google-genai.version>
        <dashscope-sdk-java.version>2.22.9</dashscope-sdk-java.version>

        <!-- Test -->
        <junit.version>5.11.4</junit.version>
        <mockito.version>5.15.2</mockito.version>
        <assertj.version>3.27.3</assertj.version>

        <!-- Build quality gate (ci-quality-gate) -->
        <jacoco.version>0.8.12</jacoco.version>
        <failsafe.version>3.5.2</failsafe.version>
        <!-- *IT integration tests need real API creds + models.json; skipped by default so a
             credential-less `mvn verify` passes. Enable with `-Pit` (or `-DskipITs=false`). -->
        <skipITs>true</skipITs>
        <!-- Ratchet floor: minimum line-coverage ratio enforced by jacoco:check per module.
             Default 0.00 (never blocks); each module overrides this to floor(current) - 0.02 so
             coverage can only ratchet up. See openspec/changes/coverage-and-ci-gate/design.md. -->
        <jacoco.line.min>0.00</jacoco.line.min>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- AgentScope Java 2.0 — split artifacts. Core + harness + per-provider model extensions.
                 The model extensions bundle their vendor SDK transitively, so the explicit SDK
                 declarations below are redundant for the migrated modules (kept only for legacy 1.x). -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-core</artifactId>
                <version>${agentscope2.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-harness</artifactId>
                <version>${agentscope2.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-openai</artifactId>
                <version>${agentscope2.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-anthropic</artifactId>
                <version>${agentscope2.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-gemini</artifactId>
                <version>${agentscope2.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-ollama</artifactId>
                <version>${agentscope2.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-dashscope</artifactId>
                <version>${agentscope2.version}</version>
            </dependency>

            <!-- LLM provider client SDKs (agentscope declares these optional, so we add
                 them explicitly to put the provider classes on the classpath) -->
            <dependency>
                <groupId>com.anthropic</groupId>
                <artifactId>anthropic-java</artifactId>
                <version>${anthropic.version}</version>
            </dependency>
            <dependency>
                <groupId>com.openai</groupId>
                <artifactId>openai-java</artifactId>
                <version>${openai-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.genai</groupId>
                <artifactId>google-genai</artifactId>
                <version>${google-genai.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>dashscope-sdk-java</artifactId>
                <version>${dashscope-sdk-java.version}</version>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-providers</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-workspace</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-task</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-session</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-channel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-onboarding</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-mcp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-plugin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-plugin-builtin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-skills-builtin</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.pigagent</groupId>
                <artifactId>pig-agent-web</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- JLine3 for terminal REPL -->
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline</artifactId>
                <version>${jline.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jline</groupId>
                <artifactId>jline-terminal-jna</artifactId>
                <version>${jline.version}</version>
            </dependency>

            <!-- Picocli for CLI parsing -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <!-- Picocli + JLine3 integration for the interactive REPL -->
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli-shell-jline3</artifactId>
                <version>${picocli.version}</version>
            </dependency>

            <!-- Jansi for colored terminal output -->
            <dependency>
                <groupId>org.fusesource.jansi</groupId>
                <artifactId>jansi</artifactId>
                <version>${jansi.version}</version>
            </dependency>

            <!-- SnakeYAML for config -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${snakeyaml.version}</version>
            </dependency>

            <!-- Jackson for JSON -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Logging facade + backend (backend only used by the entry module) -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Common test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- A logging backend on every module's TEST classpath, so SLF4J calls in tests bind to
             Logback (no "No providers found → NOP" warning). Test level is tamed via logback-test.xml. -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!-- Integration tests (*IT). Skipped by default (skipITs=true) so a credential-less
                 `mvn verify` passes without real API keys; enabled via the `it` profile. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${failsafe.version}</version>
                <configuration>
                    <skipITs>${skipITs}</skipITs>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Coverage measurement + ratchet gate (ci-quality-gate). prepare-agent instruments
                 surefire; report emits per-module html/csv/xml; check enforces the per-module line
                 floor (${jacoco.line.min}) on `verify` so coverage can only ratchet up. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- `mvn verify -Pit`: run *IT integration tests (need real API creds + models.json). -->
        <profile>
            <id>it</id>
            <properties>
                <skipITs>false</skipITs>
            </properties>
        </profile>
    </profiles>
</project>
